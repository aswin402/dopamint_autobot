# Decoupled Hono Backend Configuration
BACKEND_PORT=4000
BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"

DATABASE_URL="file:./dev.db"
# For production (Render / Neon / Supabase PostgreSQL):
# DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# JWT Authentication Secret (32+ chars random string)
JWT_SECRET="change_me_to_a_secure_random_string_in_production"

# MiniMax AI Model Configuration (OpenAI SDK Compatible)
# Obtain your key from https://platform.minimax.io
MINIMAX_API_KEY="your_minimax_api_key_here"
MINIMAX_BASE_URL="https://api.minimax.io/v1"
MINIMAX_MODEL="MiniMax-Text-01"

# Google Sheets Configuration
GOOGLE_SHEET_URL=""

# Automation Pacing Defaults
PACING_MIN_DELAY=18
PACING_MAX_DELAY=26
PACING_FIELD_DELAY_MS=350
PACING_BREATHER_INTERVAL=10
PACING_BREATHER_DURATION_SEC=120

# Fallback Values
DEFAULT_FALLBACK_PHONE=""
DEFAULT_FALLBACK_TELEGRAM=""
DEFAULT_FALLBACK_TWITTER=""
DEFAULT_FALLBACK_WALLET=""
DEFAULT_FALLBACK_WEBSITE=""
BROWSER_PROFILE_PATH="./.browser-profile"
